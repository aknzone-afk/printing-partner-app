# Lives at /opt/printing-partner-backend/.env on the Oracle VM.
# No OneDrive, no Firebase-admin: the app talks to this server directly.

# Google AI Studio key (owner-supplied). Until set, /verify-payment and /chat
# answer 503 and the app shows "being set up"; everything else works.
GEMINI_API_KEY=

# Random 64-hex; signs the payment token the phone cannot forge. Set on deploy.
PAYMENT_SECRET=

# Shared app<->server token on the Gemini endpoints (abuse-rate limiter).
API_TOKEN=

# Merchant web dashboard login.
DASHBOARD_PASSWORD=

# Where photos + _payments ledger live on this VM's disk.
DATA_ROOT=/opt/printing-partner-backend/data

# 1 = /ingest requires a verified payment token (default). 0 = testing only.
PAYMENT_ENFORCE=1
