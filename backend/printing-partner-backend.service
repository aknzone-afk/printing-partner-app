[Unit]
Description=Printing Partner backend (orders filer + server-side Gemini + merchant dashboard)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/printing-partner-backend
EnvironmentFile=/opt/printing-partner-backend/.env
ExecStart=/opt/printing-partner-backend/venv/bin/gunicorn -w 2 -b 127.0.0.1:8080 --timeout 120 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
