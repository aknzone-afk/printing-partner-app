# app/ios/fastlane/Fastfile — Mac-less TestFlight lane (copied from Sappan Sarees / AKN Chat).
#   Auth:    App Store Connect API key only (no Apple ID, no 2FA).
#   Signing: fastlane match, git storage = private repo akn-chat-ios-certs (shared, same team) (SSH deploy key).
#            The FIRST run creates the App Store profile for this new bundle id (needs MATCH_READONLY=false).
#   Build:   flutter --config-only -> gym archive + export -> pilot upload.
# Directory rule: this file runs in app/ios/fastlane, actions run in app/ios.

require "yaml"

default_platform(:ios)

APP_IDENTIFIER = "in.printingpartner.printingPartner"
TEAM_ID        = "DWJM58G45V"
XCODEPROJ      = "Runner.xcodeproj"
WORKSPACE      = "Runner.xcworkspace"
SCHEME         = "Runner"
FLUTTER_DIR    = "../.."   # app/

# App Store Connect API key (TEAM key, Admin role) — no Apple ID, no 2FA.
# Reused by every lane that talks to App Store Connect.
def asc_api_key
  app_store_connect_api_key(
    key_id:                ENV.fetch("ASC_KEY_ID"),
    issuer_id:             ENV.fetch("ASC_ISSUER_ID"),
    key_content:           ENV.fetch("ASC_KEY_P8_BASE64"),
    is_key_content_base64: true,
    duration:              1200,
    in_house:              false
  )
end

platform :ios do
  desc "Build the Flutter iOS app with match-managed signing and upload it to TestFlight"
  lane :beta do
    # 1. Fresh, unlocked keychain (a GitHub runner's login keychain cannot be unlocked).
    setup_ci(timeout: 0) if ENV["CI"]

    # 2. App Store Connect API key (TEAM key, Admin role).
    api_key = app_store_connect_api_key(
      key_id:                ENV.fetch("ASC_KEY_ID"),
      issuer_id:             ENV.fetch("ASC_ISSUER_ID"),
      key_content:           ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
      duration:              1200,
      in_house:              false
    )

    # 3. match: fetch OR create the Apple Distribution certificate + App Store profile.
    #    MATCH_READONLY_FLAG is a repo variable; set it to "true" after the first green run.
    readonly = ENV.fetch("MATCH_READONLY_FLAG", "false") == "true"
    match(
      type:                 "appstore",
      app_identifier:       [APP_IDENTIFIER],
      team_id:              TEAM_ID,
      api_key:              api_key,
      readonly:             readonly,
      force:                ENV.fetch("MATCH_FORCE_FLAG", "false") == "true",
      generate_apple_certs: true,
      storage_mode:         "git",
      git_url:              ENV.fetch("MATCH_GIT_URL"),
      git_branch:           "main",
      skip_docs:            true
    )
    profile_name = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][APP_IDENTIFIER]
    UI.user_error!("match returned no App Store profile for #{APP_IDENTIFIER}") if profile_name.to_s.empty?

    # 4. Build number = latest TestFlight build of this version + 1.
    pubspec_version   = YAML.load_file(File.join(FLUTTER_DIR, "pubspec.yaml")).fetch("version").to_s
    marketing_version = pubspec_version.split("+").first
    build_number = latest_testflight_build_number(
      api_key:              api_key,
      app_identifier:       APP_IDENTIFIER,
      version:              marketing_version,
      initial_build_number: 0
    ) + 1
    pubspec_build = pubspec_version.split("+")[1].to_i
    build_number = [build_number, pubspec_build].max
    UI.message("Building #{APP_IDENTIFIER} #{marketing_version} (#{build_number})")

    # 5. Runner target only: Automatic -> Manual signing with the match profile.
    update_code_signing_settings(
      path:                  XCODEPROJ,
      use_automatic_signing: false,
      team_id:               TEAM_ID,
      targets:               ["Runner"],
      code_sign_identity:    "Apple Distribution",
      sdk:                   "iphoneos*",
      profile_name:          profile_name,
      bundle_identifier:     APP_IDENTIFIER
    )

    # 6. Flutter writes Generated.xcconfig + Swift package + pods; nothing compiled twice.
    Dir.chdir(FLUTTER_DIR) do
      sh("flutter", "build", "ios", "--release", "--config-only", "--no-codesign",
         "--build-name=#{marketing_version}", "--build-number=#{build_number}")
    end

    # 6b. Download all Swift packages once, so -showBuildSettings / archive do not time out.
    sh("cd .. && xcodebuild -resolvePackageDependencies -workspace #{WORKSPACE} -scheme #{SCHEME} -clonedSourcePackagesDirPath ../build/ios/SourcePackages")

    # 7. Archive + export.
    build_app(
      workspace:              WORKSPACE,
      scheme:                 SCHEME,
      configuration:          "Release",
      export_method:          "app-store",
      export_team_id:         TEAM_ID,
      export_options: {
        signingStyle:         "manual",
        teamID:               TEAM_ID,
        provisioningProfiles: { APP_IDENTIFIER => profile_name },
        uploadSymbols:        true,
        compileBitcode:       false
      },
      skip_profile_detection: true,
      include_bitcode:        false,
      include_symbols:        true,
      xcargs:                 "COMPILER_INDEX_STORE_ENABLE=NO",
      output_directory:       "../build/ios/ipa",
      output_name:            "printing_partner",
      buildlog_path:          "fastlane/logs",
      cloned_source_packages_path: "../build/ios/SourcePackages"
    )

    # 8. Upload; do not wait for Apple's processing (saves macOS minutes).
    upload_to_testflight(
      api_key:                           api_key,
      app_identifier:                    APP_IDENTIFIER,
      ipa:                               lane_context[SharedValues::IPA_OUTPUT_PATH],
      skip_waiting_for_build_processing: true,
      distribute_external:               false
    )

    UI.success("Uploaded #{APP_IDENTIFIER} #{marketing_version} (#{build_number}) to TestFlight.")
  end

  # ---------------------------------------------------------------------------
  # App Store (public release) lanes. The binary is uploaded by `beta` above;
  # these push the store listing (metadata + screenshots) and, optionally,
  # submit the newest TestFlight build for App Store review.
  #
  # Fill fastlane/metadata/en-US/* and drop store PNGs in fastlane/screenshots/
  # (the "Store screenshots" workflow produces them) BEFORE running these.
  # The final human "Submit" is the owner's call — SUBMIT_FOR_REVIEW defaults to
  # false so a run never submits by accident; set SUBMIT_FOR_REVIEW=true only
  # when the listing is complete and the owner wants to submit.
  # ---------------------------------------------------------------------------

  desc "Upload App Store metadata + screenshots (and optionally submit for review)"
  lane :release do
    submit = ENV.fetch("SUBMIT_FOR_REVIEW", "false") == "true"
    deliver(
      api_key:              asc_api_key,
      app_identifier:       APP_IDENTIFIER,
      team_id:              nil,
      metadata_path:        "./fastlane/metadata",
      screenshots_path:     "./fastlane/screenshots",
      skip_binary_upload:   true,    # the IPA comes from the `beta` lane
      skip_app_version_update: false,
      submit_for_review:    submit,
      automatic_release:    false,   # owner releases manually after approval
      force:                true,    # no interactive HTML preview on CI
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false # Printing Partner shows no ads / no IDFA
      }
    )
    UI.success("App Store listing pushed for #{APP_IDENTIFIER}. submit_for_review=#{submit}")
  end

  desc "Upload ONLY the store screenshots (fastlane/screenshots/<locale>/)"
  lane :screenshots do
    deliver(
      api_key:            asc_api_key,
      app_identifier:     APP_IDENTIFIER,
      screenshots_path:   "./fastlane/screenshots",
      skip_binary_upload: true,
      skip_metadata:      true,
      skip_app_version_update: true,
      submit_for_review:  false,
      force:              true
    )
    UI.success("Screenshots uploaded for #{APP_IDENTIFIER}.")
  end

  desc "Upload ONLY the text metadata (fastlane/metadata/)"
  lane :metadata do
    deliver(
      api_key:            asc_api_key,
      app_identifier:     APP_IDENTIFIER,
      metadata_path:      "./fastlane/metadata",
      skip_binary_upload: true,
      skip_screenshots:   true,
      skip_app_version_update: false,
      submit_for_review:  false,
      force:              true
    )
    UI.success("Metadata uploaded for #{APP_IDENTIFIER}.")
  end

  # The Apple-review demo video (Guideline 2.1) is produced by the
  # .github/workflows/ios-review-video.yml workflow (simctl recordVideo around
  # integration_test/review_flow_test.dart), matching the sibling apps — it is
  # not a fastlane lane because the recording is driven by the CI runner's
  # simctl, not by gym/pilot.

  error do |lane, exception|
    UI.error("Lane #{lane} failed: #{exception.message}")
  end
end
